# Supabase project settings (Project Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Used by admin API routes (schedule import) that must bypass
# RLS in controlled ways. NEVER expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Used by the cron route (mark no-shows / dispatch emails) to authenticate
# the scheduler -> app call. Generate any random string.
CRON_SECRET=change-me

# Resend (https://resend.com) for transactional email: missed attendance,
# late cancellation, waitlist promotion notices.
RESEND_API_KEY=your-resend-api-key
NOTIFICATIONS_FROM_EMAIL="Unison Fitness <notifications@unison.fitness>"
